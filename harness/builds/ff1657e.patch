+        assert!(!EDIT_TOOLS.contains(&"run_command"));
+        assert_eq!(tool_set_for("unknown"), None);
+    }
+
+    #[test]
+    fn three_tool_arms_admit_one_form_per_tool() {
+        let lines = edit_shapes(
+            &json!({"files":[{"path":"a","edits":[{"start_line":1,"end_line":1,"new_text":"x"}]}]}),
+        );
+        let text =
+            edit_shapes(&json!({"files":[{"path":"a","edits":[{"old_text":"a","new_text":"b"}]}]}));
+        let patch = edit_shapes(&json!({"patch":"*** Begin Patch\n*** End Patch","revisions":{}}));
+        let content = edit_shapes(&json!({"files":[{"path":"a","content":"x"}]}));
+        for (tool, own) in [
+            ("edit_lines", &lines),
+            ("edit_text", &text),
+            ("apply_patch", &patch),
+        ] {
+            assert!(is_edit_tool(tool));
+            assert_eq!(tool_purity_error(tool, own), None);
+            // Whole-file content stays available under every tool, as in every arm.
+            assert_eq!(tool_purity_error(tool, &content), None);
+            for other in [&lines, &text, &patch] {
+                assert_eq!(tool_purity_error(tool, other).is_some(), other != own);
+            }
+        }
+        assert_eq!(
+            tool_purity_error("edit_lines", &text).unwrap(),
+            "edit_lines accepts only the lines form or whole-file content; this call used: text"
+        );
+        assert!(!is_edit_tool("read_file"));
+        assert_eq!(tool_purity_error("read_file", &text), None);
+        // The per-mode check stands aside; the per-tool one above replaces it.
+        for mode in [EditingMode::ChoiceTools, EditingMode::ChoiceToolsGuided] {
+            assert!(three_tool_mode(mode));
+            assert_eq!(purity_error(mode, &lines), None);
+        }
+        assert!(!three_tool_mode(EditingMode::Choice));
+    }
+
+    #[test]
+    fn classifies_every_apply_patch_form() {
+        let cases = [
+            (
+                json!({"files":[{"path":"a","expected_revision":"0123456789abcdef","edits":[{"start_line":1,"end_line":2,"new_text":"x"}]}]}),
+                vec!["lines"],
+            ),
+            (
+                json!({"files":[{"path":"a","expected_revision":"0123456789abcdef","edits":[{"old_text":"a","new_text":"b"}]}]}),
+                vec!["text"],
+            ),
+            (
+                json!({"patch":"*** Begin Patch\n*** End Patch","revisions":{}}),
+                vec!["patch"],
+            ),
+            (
+                json!({"files":[{"path":"a","expected_revision":null,"content":"x"}]}),
+                vec!["content"],
+            ),
+            (json!({"path":"a","content":"x"}), vec!["content"]),
+            (
+                json!({"path":"a","edits":[{"old_text":"a","new_text":"b"}]}),
+                vec!["text"],
+            ),
+            (
+                json!({"files":[{"path":"a","edits":[{"start_line":1,"end_line":1,"new_text":"x"}]},{"path":"b","edits":[{"old_text":"a","new_text":"b"}]}]}),
+                vec!["lines", "text"],
+            ),
+            (
+                json!({"files":[{"path":"a","edits":[{"start_line":1,"old_text":"a","new_text":"x"}]}]}),
+                vec!["lines", "text"],
+            ),
+            (
+                json!({"files":[{"path":"a","content":"x"},{"path":"b","edits":[{"old_text":"a","new_text":"b"}]}]}),
+                vec!["text", "content"],
+            ),
+            (
+                json!({"patch":"x","files":[{"path":"a","content":"x"}]}),
+                vec!["patch", "content"],
+            ),
+            (
+                json!({"files":[{"path":"a","edits":[{"end_line":3,"new_text":"x"}]}]}),
+                vec!["lines"],
+            ),
+            (
+                json!({"files":[{"path":"a","edits":[{"new_text":"x"}]}]}),
+                vec!["unknown"],
+            ),
+            (json!({"files":"a"}), vec!["unknown"]),
+            (json!({"files":[{"path":"a","edits":"x"}]}), vec!["unknown"]),
+            (json!({}), vec!["unknown"]),
+            (json!([1]), vec!["unknown"]),
+        ];
+        for (arguments, expected) in cases {
+            assert_eq!(shapes(&arguments), expected, "{arguments}");
+        }
+    }
+
+    #[test]
+    fn single_format_arms_reject_other_forms_with_one_message_shape() {
+        let lines = edit_shapes(
+            &json!({"files":[{"path":"a","edits":[{"start_line":1,"end_line":1,"new_text":"x"}]}]}),
+        );
+        let text =
+            edit_shapes(&json!({"files":[{"path":"a","edits":[{"old_text":"a","new_text":"b"}]}]}));
+        let patch = edit_shapes(&json!({"patch":"*** Begin Patch\n*** End Patch","revisions":{}}));
+        let content = edit_shapes(&json!({"files":[{"path":"a","content":"x"}]}));
+        let unknown = edit_shapes(&json!({"files":"a"}));
+        assert_eq!(purity_error(EditingMode::Lines, &lines), None);
+        assert_eq!(purity_error(EditingMode::Text, &text), None);
+        assert_eq!(purity_error(EditingMode::Patch, &patch), None);
+        for mode in [
+            EditingMode::Lines,
+            EditingMode::Text,
+            EditingMode::Patch,
+            EditingMode::Choice,
+        ] {
+            assert_eq!(purity_error(mode, &content), None);
+            assert_eq!(purity_error(mode, &unknown), None);
+        }
