+impl DaemonToolExecutor {
+    /// `called` is the tool name the model used, which in the three-tool arms
+    /// decides the form that call may carry.
+    async fn experiment_purity_error(
+        &self,
+        called: &str,
+        arguments: &serde_json::Value,
+    ) -> Option<String> {
+        let mode = match self.state.store.get_session(&self.session_id).await {
+            Ok(session) => self.state.editing_profiles.resolve(&session.model),
+            Err(error) => return Some(format!("experiment editing-mode lookup failed: {error}")),
+        };
+        let shapes = experiment::edit_shapes(arguments);
+        if experiment::three_tool_mode(mode) {
+            experiment::tool_purity_error(called, &shapes)
+        } else {
+            experiment::purity_error(mode, &shapes)
+        }
+    }
+
+    /// In the three-tool arms the model calls `edit_lines`, `edit_text` or
+    /// `apply_patch`, and they are one tool to everything past this point:
+    /// approval, scheduling claims, permissions and execution only know
+    /// `apply_patch`. The conversation keeps the name the model used. Outside
+    /// those arms an alias is an unoffered tool and is rejected as one.
+    async fn experiment_edit_tool<'a>(&self, tool: &'a str) -> &'a str {
+        if tool == "apply_patch" || !experiment::enabled() || !experiment::is_edit_tool(tool) {
+            return tool;
+        }
+        match self.state.store.get_session(&self.session_id).await {
+            Ok(session)
+                if experiment::three_tool_mode(
+                    self.state.editing_profiles.resolve(&session.model),
+                ) =>
+            {
+                "apply_patch"
+            }
+            _ => tool,
+        }
+    }
+}
