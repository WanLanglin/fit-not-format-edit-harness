+        let arguments = r#"{"patch":"*** Begin Patch\n*** Update File: a\n@@\n-x\n+y\n@@\n-z\n+w\n*** End Patch","revisions":{"a":"0123456789abcdef"}}"#;
+        let error = "token=sk-abcdefghijklmnopqrstuvwxyz";
+        let payload = tool_call_payload("call_1", "apply_patch", arguments, "failed", Some(error));
+        assert_eq!(super::super::redact(payload.clone()), payload);
+        let decode = |hex: &str| {
+            (0..hex.len())
+                .step_by(2)
+                .map(|index| u8::from_str_radix(&hex[index..index + 2], 16).unwrap())
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(
+            decode(payload["arguments"]["hex"].as_str().unwrap()),
+            arguments.as_bytes()
+        );
+        assert_eq!(
+            decode(payload["error"]["hex"].as_str().unwrap()),
+            error.as_bytes()
+        );
+        assert_eq!(payload["edit_forms"], json!(["patch"]));
+        assert_eq!(
+            payload["edit_counts"],
+            json!({"files": 1, "edits": 0, "patch_hunks": 2})
+        );
+        let large = "x".repeat(MAX_RECORDED_BYTES + 1);
+        let payload = tool_call_payload("call_2", "run_command", &large, "completed", None);
+        assert_eq!(payload["arguments"]["truncated"], json!(true));
+        assert_eq!(payload["arguments"]["bytes"], json!(MAX_RECORDED_BYTES + 1));
+        assert!(payload["edit_forms"].is_null());
+    }
+}
