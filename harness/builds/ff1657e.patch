+INSTANCE = "inst_fake_0123456789abcdef"
+FAKE_SCRIPT = """#!/bin/sh
+if [ "$1" = "--version" ]; then
+  echo "s-code 0.0.0-fake"
+  exit 0
+fi
+printf 'cwd=%s\\n' "$PWD" >&2
