+    let prompt = messages
+        .iter()
+        .filter(|message| message.role == "system")
+        .find_map(|message| {
+            message
+                .content
+                .as_str()
+                .filter(|text| text.starts_with(PROMPT_MARKER))
+        })
+        .unwrap_or_default();
+    let tool_text = |tool: &ToolDefinition| {
+        format!("{}\n{}\n{}\n", tool.name, tool.description, tool.parameters)
+    };
+    json!({
+        "editing_mode": mode,
+        "choice_order": order.map(EditingForm::name),
+        "editing_prompt_sha256": digest(prompt),
+        "apply_patch_sha256": tools
+            .iter()
+            .find(|tool| tool.name == "apply_patch")
+            .map(|tool| digest(&tool_text(tool))),
+        "tools": tools.iter().map(|tool| tool.name.as_str()).collect::<Vec<_>>(),
+        "tools_sha256": digest(&tools.iter().map(tool_text).collect::<String>()),
+    })
+}
