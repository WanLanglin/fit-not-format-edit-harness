+//! Experiment-only instrumentation for the edit-format benchmark.
+//! Everything here is inert unless `S_CODE_EXPERIMENT` is set.
+use s_code_config::EditingMode;
+use serde_json::{Value, json};
+use std::{collections::BTreeSet, fmt::Write as _};
+
+const MAX_RECORDED_BYTES: usize = 512 * 1024;
+
+pub(crate) fn enabled() -> bool {
+    std::env::var_os("S_CODE_EXPERIMENT").is_some()
+}
+
+/// An experiment-only override, ignored unless `S_CODE_EXPERIMENT` is set.
+pub(crate) fn env_override<T: std::str::FromStr>(name: &str) -> Option<T> {
+    enabled()
+        .then(|| std::env::var(name).ok()?.parse().ok())
+        .flatten()
+}
+
+/// Tools offered when `S_CODE_EXPERIMENT_TOOL_SET=edit`: no command execution.
+pub(crate) const EDIT_TOOLS: &[&str] = &["read_file", "list_files", "search_text", "apply_patch"];
+
+fn tool_set_for(name: &str) -> Option<&'static [&'static str]> {
+    match name {
+        "edit" => Some(EDIT_TOOLS),
+        _ => None,
+    }
+}
+
+/// The experiment tool allowlist, if one is selected.
+pub(crate) fn tool_set() -> Option<&'static [&'static str]> {
+    enabled()
+        .then(|| std::env::var("S_CODE_EXPERIMENT_TOOL_SET").ok())
+        .flatten()
+        .and_then(|name| tool_set_for(&name))
+}
+
+pub(crate) fn tool_offered(tool: &str) -> bool {
+    tool_set().is_none_or(|tools| tools.contains(&tool))
+}
+
+/// The edit tools of the three-tool arms. `apply_patch` is the patch form's name
+/// there and the only edit tool in every other arm; the other two are aliases the
+/// executor maps onto `apply_patch`, so nothing downstream learns new tool names.
+pub(crate) const EDIT_TOOL_NAMES: &[&str] = &["edit_lines", "edit_text", "apply_patch"];
+
+pub(crate) fn is_edit_tool(tool: &str) -> bool {
+    EDIT_TOOL_NAMES.contains(&tool)
+}
+
+pub(crate) fn three_tool_mode(mode: EditingMode) -> bool {
+    matches!(
+        mode,
+        EditingMode::ChoiceTools | EditingMode::ChoiceToolsGuided
+    )
+}
+
+/// The one form a three-tool arm's tool admits.
+fn tool_shape(tool: &str) -> Option<EditShape> {
+    match tool {
+        "edit_lines" => Some(EditShape::Lines),
+        "edit_text" => Some(EditShape::Text),
+        "apply_patch" => Some(EditShape::Patch),
+        _ => None,
+    }
+}
+
+/// The shape of one edit inside `apply_patch` arguments.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) enum EditShape {
+    Lines,
+    Text,
+    Patch,
+    Content,
+    Unknown,
+}
+
+impl EditShape {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Lines => "lines",
+            Self::Text => "text",
+            Self::Patch => "patch",
+            Self::Content => "content",
+            Self::Unknown => "unknown",
+        }
+    }
+}
+
+/// Every edit shape present in `apply_patch` arguments. Malformed input is
+/// `Unknown`; execution still reports the precise error.
+pub(crate) fn edit_shapes(arguments: &Value) -> BTreeSet<EditShape> {
+    let mut shapes = BTreeSet::new();
+    let Some(object) = arguments.as_object() else {
+        shapes.insert(EditShape::Unknown);
+        return shapes;
+    };
+    if object.contains_key("patch") {
+        shapes.insert(EditShape::Patch);
+    }
+    let files: Vec<&Value> = match object.get("files") {
+        Some(Value::Array(files)) => files.iter().collect(),
+        Some(_) => {
+            shapes.insert(EditShape::Unknown);
+            Vec::new()
+        }
+        None if object.contains_key("path") => vec![arguments],
+        None => Vec::new(),
+    };
+    for file in files {
+        if file.get("content").is_some() {
+            shapes.insert(EditShape::Content);
+        }
+        match file.get("edits") {
+            Some(Value::Array(edits)) => {
+                for edit in edits {
+                    let lines = edit.get("start_line").is_some() || edit.get("end_line").is_some();
+                    let text = edit.get("old_text").is_some();
+                    if lines {
+                        shapes.insert(EditShape::Lines);
+                    }
+                    if text {
+                        shapes.insert(EditShape::Text);
+                    }
+                    if !lines && !text {
+                        shapes.insert(EditShape::Unknown);
+                    }
+                }
+            }
+            Some(_) => {
+                shapes.insert(EditShape::Unknown);
+            }
+            None => {}
+        }
+    }
+    if shapes.is_empty() {
+        shapes.insert(EditShape::Unknown);
+    }
+    shapes
+}
+
+/// The uniform rejection for an edit form a single-format arm does not offer.
+/// Whole-file content stays allowed in every arm, as in PR #68.
+pub(crate) fn purity_error(mode: EditingMode, shapes: &BTreeSet<EditShape>) -> Option<String> {
+    let offered = match mode {
+        EditingMode::Lines => EditShape::Lines,
+        EditingMode::Text => EditShape::Text,
+        EditingMode::Patch => EditShape::Patch,
+        EditingMode::Auto | EditingMode::Choice | EditingMode::ChoiceGuided => return None,
+        // The three-tool arms are checked per called tool by `tool_purity_error`.
+        EditingMode::ChoiceTools | EditingMode::ChoiceToolsGuided => return None,
+    };
+    let rejected = shapes
+        .iter()
+        .filter(|shape| {
+            !matches!(shape, EditShape::Content | EditShape::Unknown) && **shape != offered
+        })
+        .map(|shape| shape.name())
+        .collect::<Vec<_>>();
+    (!rejected.is_empty()).then(|| {
+        format!(
+            "this session's apply_patch accepts only the {} form or whole-file content; this call used: {}",
+            offered.name(),
+            rejected.join(", ")
+        )
+    })
+}
+
+/// The three-tool arms' counterpart of `purity_error`: each tool admits its own
+/// form, plus whole-file content as everywhere else. The schema already says so;
+/// this holds for arguments a provider did not validate against it.
+pub(crate) fn tool_purity_error(tool: &str, shapes: &BTreeSet<EditShape>) -> Option<String> {
+    let offered = tool_shape(tool)?;
+    let rejected = shapes
+        .iter()
+        .filter(|shape| {
+            !matches!(shape, EditShape::Content | EditShape::Unknown) && **shape != offered
+        })
+        .map(|shape| shape.name())
+        .collect::<Vec<_>>();
+    (!rejected.is_empty()).then(|| {
+        format!(
+            "{tool} accepts only the {} form or whole-file content; this call used: {}",
+            offered.name(),
+            rejected.join(", ")
+        )
+    })
+}
+
+/// Rejection for a tool outside the bench tool set, including tools the model
+/// names without having been offered them.
+pub(crate) fn tool_rejection(tool: &str) -> Option<String> {
+    (!tool_offered(tool)).then(|| format!("tool {tool} is not available in this session"))
+}
+
+/// Payload for `experiment.tool_call`. Arguments and errors are hex-encoded so
+/// audit redaction cannot rewrite them; sha256 always covers the full text.
+pub(crate) fn tool_call_payload(
+    call_id: &str,
+    tool: &str,
+    arguments: &str,
+    outcome: &str,
+    error: Option<&str>,
+) -> Value {
+    // Recorded under the name the model called, which in the three-tool arms is
+    // the choice it made.
+    let parsed = is_edit_tool(tool)
+        .then(|| serde_json::from_str::<Value>(arguments).ok())
+        .flatten();
+    json!({
+        "model_call_id": call_id,
+        "tool": tool,
+        "outcome": outcome,
+        "arguments": recorded(arguments),
+        "error": error.map(recorded),
+        "edit_forms": parsed.as_ref().map(|value| {
+            edit_shapes(value).into_iter().map(EditShape::name).collect::<Vec<_>>()
+        }),
+        "edit_counts": parsed.as_ref().map(edit_counts),
+    })
+}
+
+fn recorded(text: &str) -> Value {
+    use sha2::{Digest, Sha256};
+    let bytes = text.as_bytes();
+    let kept = &bytes[..bytes.len().min(MAX_RECORDED_BYTES)];
+    let mut hex = String::with_capacity(kept.len() * 2);
+    for byte in kept {
+        let _ = write!(hex, "{byte:02x}");
+    }
+    json!({
+        "bytes": bytes.len(),
+        "sha256": format!("{:x}", Sha256::digest(bytes)),
+        "hex": hex,
+        "truncated": kept.len() < bytes.len(),
+    })
+}
+
+fn edit_counts(arguments: &Value) -> Value {
+    let files = arguments.get("files").and_then(Value::as_array);
+    let legacy = arguments.get("path").map(|_| arguments);
+    let patch = arguments.get("patch").and_then(Value::as_str).unwrap_or("");
+    let patch_files = patch
+        .lines()
+        .filter(|line| line.starts_with("*** Add File: ") || line.starts_with("*** Update File: "))
+        .count();
+    json!({
+        "files": files.map_or(usize::from(legacy.is_some()), Vec::len) + patch_files,
+        "edits": files
+            .into_iter()
+            .flatten()
+            .chain(legacy)
+            .filter_map(|file| file.get("edits").and_then(Value::as_array))
